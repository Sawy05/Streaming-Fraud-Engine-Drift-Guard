# ==============================================================================
# Streaming Fraud Engine & Drift Guard — Environment Configuration
# ==============================================================================

# --- Kafka / Redpanda Streaming ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_TRANSACTIONS=financial.transactions.v1
KAFKA_TOPIC_PREDICTIONS=financial.fraud_predictions.v1
PRODUCER_THROUGHPUT_EPS=500
FRAUD_BASE_RATE=0.015

# --- Feast Feature Store & Redis Online Store ---
FEAST_REPO_PATH=feature_repo
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
USE_FAKEREDIS_FALLBACK=true

# --- Offline Store & Model Paths ---
OFFLINE_DATA_PATH=data/offline_transactions.parquet
USER_FEATURES_PATH=data/user_features.parquet
MERCHANT_FEATURES_PATH=data/merchant_features.parquet
REFERENCE_BASELINE_PATH=data/reference_baseline.parquet
DUCKDB_PATH=data/feature_offline.duckdb
LIGHTGBM_MODEL_PATH=models/fraud_lgbm.txt
ONNX_MODEL_PATH=models/fraud_model.onnx
MODEL_METADATA_PATH=models/model_metadata.json

# --- FastAPI ONNX Serving & SLA ---
SERVING_HOST=0.0.0.0
SERVING_PORT=8000
FRAUD_PROBABILITY_THRESHOLD=0.50
FRAUD_REVIEW_THRESHOLD=0.25
SLA_P99_LATENCY_MS=15.0
ORT_INTRA_OP_THREADS=1
ORT_INTER_OP_THREADS=1

# --- Evidently AI & Statistical Drift Monitoring ---
DRIFT_WINDOW_SIZE=500
DRIFT_KS_ALPHA=0.05
DRIFT_WASSERSTEIN_THRESHOLD=0.15
NULL_SPIKE_THRESHOLD=0.05
ALERT_WEBHOOK_URL=http://localhost:8000/v1/drift/webhook-sink
ALERT_WEBHOOK_TIMEOUT_SEC=3.0
PROMETHEUS_PORT=9090
